{
  "_comment": "Every file the service worker precaches (app shell), plus the terrain JPEGs it runtime-caches cache-first. Paths are relative to the site root. sw.js must use exactly these names.",
  "precache": [
    "./",
    "./index.html",
    "./css/app.css",
    "./css/fonts.css",
    "./js/app.js",
    "./js/accent.js",
    "./js/vendor/qrcode.js",
    "./data/na.json",
    "./data/world.json",
    "./manifest.webmanifest",
    "./icons/icon.svg",
    "./icons/icon-192.png",
    "./icons/icon-512.png",
    "./icons/icon-maskable-512.png",
    "./icons/apple-touch-icon.png",
    "./fonts/bricolage-grotesque-latin.woff2",
    "./fonts/ibm-plex-sans-400-latin.woff2",
    "./fonts/ibm-plex-sans-500-latin.woff2",
    "./fonts/ibm-plex-sans-600-latin.woff2",
    "./fonts/ibm-plex-mono-400-latin.woff2",
    "./fonts/ibm-plex-mono-500-latin.woff2"
  ],
  "runtime_cache_first": [
    "./terrain/world.jpg",
    "./terrain/na.jpg",
    "./terrain/inset-0.jpg",
    "./terrain/inset-1.jpg",
    "./terrain/inset-2.jpg",
    "./terrain/inset-3.jpg",
    "./terrain/inset-4.jpg",
    "./terrain/inset-5.jpg",
    "./terrain/inset-6.jpg"
  ]
}
